{
  "name": "try-typespec-editor",
  "version": "2025.8.26",
  "scripts": {
    "ng": "ng",
    "lint": "ng lint",
    "prestart": "npm run prebuild debug-preview",
    "start": "ng serve",
    "prebuild": "node convert-schema.js",
    "build": "ng build",
    "watch": "ng build --watch --configuration development"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.2.4",
    "@angular/compiler": "^20.2.4",
    "@angular/core": "^21.1.2",
    "@angular/forms": "^20.2.4",
    "@angular/platform-browser": "^20.1.0",
    "@fortawesome/angular-fontawesome": "^3.0.0",
    "@fortawesome/free-solid-svg-icons": "^7.0.0",
    "purecss": "^3.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.2.2",
    "@angular/cli": "^20.2.2",
    "@angular/compiler-cli": "^20.2.4",
    "angular-eslint": "20.1.1",
    "eslint": "^9.29.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "8.34.1"
  }
}
